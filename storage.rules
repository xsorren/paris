rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Permitir lectura de imágenes para todos los usuarios
    match /images/{allPaths=**} {
      allow read: if true;
    }
    
    // Permitir escritura solo para usuarios autenticados
    match /images/{allPaths=**} {
      allow write: if request.auth != null;
    }
    
    // Permitir lectura y escritura para propiedades solo si el usuario está autenticado
    match /properties/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
    // Reglas específicas para carpetas organizadas por tipo de propiedad y operación
    match /images/casas/venta/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /images/casas/alquiler/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /images/departamentos/venta/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /images/departamentos/alquiler/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /images/lotes/venta/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /images/lotes/alquiler/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /images/locales/venta/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /images/locales/alquiler/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /images/otros/venta/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /images/otros/alquiler/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
