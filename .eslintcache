    </div>\r\n                            <div className=\"col-lg-4\">\r\n                                <div className=\"fd-sidebar-item\">\r\n                                    <h4>Recently Added</h4>\r\n                                    <div className=\"recently-item\">\r\n                                        <img src=\"/img/product1.jpeg\" alt=\"detail\" width=\"50px\" />\r\n                                        <span>Lorem Ipsum Dolor</span>\r\n                                    </div>\r\n                                    <div className=\"recently-item\">\r\n                                        <img src=\"/img/product1.jpeg\" alt=\"detail\" width=\"50px\" />\r\n                                        <span>Lorem Ipsum Dolor</span>\r\n                                    </div>\r\n                                    <div className=\"recently-item\">\r\n                                        <img src=\"/img/product1.jpeg\" alt=\"detail\" width=\"50px\" />\r\n                                        <span>Lorem Ipsum Dolor</span>\r\n                                    </div>\r\n                                </div>\r\n                                <div className=\"fd-sidebar-item\">\r\n                                    <h4>Category</h4>\r\n                                    <ul className=\"category-ul\">\r\n                                        <li>Category 1</li>\r\n                                        <li>Category 2</li>\r\n                                        <li>Category 3</li>\r\n                                        <li>Category 4</li>\r\n                                        <li>Category 5</li>\r\n                                    </ul>\r\n                                </div>\r\n                                <div className=\"fd-sidebar-item\">\r\n                                    <h4>Recently Added</h4>\r\n                                    <div className=\"recently-item\">\r\n                                        <img src=\"/img/product1.jpeg\" alt=\"detail\" width=\"50px\" />\r\n                                        <span>Lorem Ipsum Dolor</span>\r\n                                    </div>\r\n                                    <div className=\"recently-item\">\r\n                                        <img src=\"/img/product1.jpeg\" alt=\"detail\" width=\"50px\" />\r\n                                        <span>Lorem Ipsum Dolor</span>\r\n                                    </div>\r\n                                    <div className=\"recently-item\">\r\n                                        <img src=\"/img/product1.jpeg\" alt=\"detail\" width=\"50px\" />\r\n                                        <span>Lorem Ipsum Dolor</span>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    )\r\n}\r\n\r\nexport default FlatDetail","C:\\Users\\peral\\Desktop\\Proyect\\paris\\src\\components\\BlogDetail.js",["118","119","120","121"],"import React, { useState } from 'react';\r\nimport { useLocation } from 'react-router-dom';\r\nimport { Carousel } from 'react-bootstrap';\r\nimport Sidebar from \"./Sidebar\";\r\nimport styled from 'styled-components';\r\nimport Modal from 'react-modal';\r\n\r\n// Estilos\r\nconst Container = styled.div`\r\n    margin-top: 2rem;\r\n    margin-bottom: 2rem;\r\n`;\r\n\r\nconst CustomCarousel = styled(Carousel)`\r\n    .carousel-inner {\r\n        border-radius: 15px;\r\n        overflow: hidden;\r\n        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);\r\n    }\r\n`;\r\n\r\nconst CarouselItemCentered = styled(Carousel.Item)`\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    height: 400px;\r\n`;\r\n\r\nconst CenteredImage = styled.img`\r\n    max-width: 100%;\r\n    height: auto;\r\n    object-fit: cover;\r\n    border-radius: 10px;\r\n    cursor: pointer;\r\n`;\r\n\r\nModal.setAppElement('#root');\r\n\r\nconst BlogDetail = () => {\r\n    const { state } = useLocation();\r\n    const property = state.property;\r\n    const [isModalOpen, setIsModalOpen] = useState(false);\r\n    const [selectedImage, setSelectedImage] = useState(\"\");\r\n    const [currentIndex, setCurrentIndex] = useState(0);\r\n\r\n    const openModal = (image, index) => {\r\n        setSelectedImage(image);\r\n        setCurrentIndex(index);\r\n        setIsModalOpen(true);\r\n    };\r\n\r\n    const closeModal = () => {\r\n        setIsModalOpen(false);\r\n        setSelectedImage(\"\");\r\n    };\r\n\r\n    return (\r\n        <Container className=\"container\">\r\n            <div className=\"row\">\r\n                <div className=\"col-lg-8 order-lg-1\">\r\n                    <div className=\"blog-detail\">\r\n                        <CustomCarousel interval={5000} indicators={false} controls={true} fade>\r\n                            {property.images && property.images.length > 0 ? (\r\n                                property.images.map((image, index) => (\r\n                                    <CarouselItemCentered key={index}>\r\n                                        <CenteredImage\r\n                                            src={image}\r\n                                            alt={`Imagen ${index + 1}`}\r\n                                            onClick={() => openModal(image, index)}\r\n                                        />\r\n                                    </CarouselItemCentered>\r\n                                ))\r\n                            ) : (\r\n                                <CarouselItemCentered>\r\n                                    <CenteredImage\r\n                                        src={process.env.REACT_APP_DEFAULT_IMAGE_URL}\r\n                                        alt=\"Imagen predeterminada\"\r\n                                        onClick={() => openModal(process.env.REACT_APP_DEFAULT_IMAGE_URL, 0)}\r\n                                    />\r\n                                </CarouselItemCentered>\r\n                            )}\r\n                        </CustomCarousel>\r\n\r\n                        <span className=\"blog-detail-category\">{property.type}</span>\r\n                        <h1 className=\"blog-detail-title\">{property.title} - {property.location}</h1>\r\n                        <span className=\"blog-detail-date\">Publicado el {property.date}</span>\r\n                        <p className=\"blog-detail-content\">{property.description}</p>\r\n                    </div>\r\n                </div>\r\n                <div className=\"col-lg-4 order-lg-2\">\r\n                    <Sidebar />\r\n                </div>\r\n            </div>\r\n        </Container>\r\n    );\r\n};\r\n\r\nexport default BlogDetail;\r\n","C:\\Users\\peral\\Desktop\\Proyect\\paris\\src\\components\\Contact.js",[],"C:\\Users\\peral\\Desktop\\Proyect\\paris\\src\\components\\Login.js",[],"C:\\Users\\peral\\Desktop\\Proyect\\paris\\src\\components\\CreateProperty.js",[],"C:\\Users\\peral\\Desktop\\Proyect\\paris\\src\\components\\Blog.js",[],"C:\\Users\\peral\\Desktop\\Proyect\\paris\\src\\components\\FlatList.js",[],"C:\\Users\\peral\\Desktop\\Proyect\\paris\\src\\components\\Subscribe.js",[],"C:\\Users\\peral\\Desktop\\Proyect\\paris\\src\\components\\References.js",[],"C:\\Users\\peral\\Desktop\\Proyect\\paris\\src\\components\\Map.js",["122"],"const Map = () => {\r\n    return (\r\n        <div>\r\n            <iframe src=\"https://www.google.com/maps/embed?pb=!1m14!1m12!1m3!1d817.05665717051!2d-59.27219640453109!3d-35.00103162084303!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!5e0!3m2!1ses-419!2sar!4v1718147709253!5m2!1ses-419!2sar\" width=\"100%\" height=\"450\" loading=\"lazy\"></iframe>\r\n        </div>\r\n    );\r\n};\r\n\r\nexport default Map;\r\n","C:\\Users\\peral\\Desktop\\Proyect\\pari