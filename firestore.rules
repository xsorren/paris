rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir lectura pública de propiedades
    match /propiedades/{propiedad} {
      allow read: if true;
      // Solo el administrador puede escribir
      allow write: if request.auth != null && request.auth.token.email == 'parispropiedadesinfo@gmail.com';
    }
    
    // Denegar todo lo demás por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}